{title: Nothing Compares 2 U}
{subtitle: Chris Cornell (acoustic version)}


{define: Do base-fret 0 frets x 3 2 0 1 0}
{define: Sol base-fret 0 frets 3 2 0 0 0 3}
{define: Sol/Si base-fret 0 frets x 2 0 0 0 3}
{define: Lam base-fret 0 frets x 0 2 2 1 0}
{define: Fa base-fret 1 frets 1 3 3 2 1 1}
{define: Mi base-fret 0 frets 0 2 2 1 0 0}
{define: Sib base-fret 1 frets 1 1 3 3 3 1}
{define: Rem base-fret 0 frets x x 0 2 3 1}
{define: Fasus4 base-fret 1 frets 1 3 3 3 1 1}
{define: Mim base-fret 0 frets 0 2 2 0 0 0}

{comment: Intro}
